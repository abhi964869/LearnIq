# LearnIQ AI works with EITHER provider — set exactly one key.
# Local:  copy this file to .env and paste your key (loaded automatically).
# Vercel: Project Settings -> Environment Variables.

# Option A — Google Gemini (aistudio.google.com/apikey — new keys start with AQ.):
GEMINI_API_KEY=

# Option B — Anthropic Claude (console.anthropic.com):
ANTHROPIC_API_KEY=

# Optional overrides:
# LEARNIQ_PROVIDER=gemini        # force provider if both keys are set
# LEARNIQ_MODEL=gemini-2.5-flash # or e.g. claude-sonnet-5

# --- Optional: Supabase (accounts + cross-device data sync) ---
# Leave blank to run in local guest mode (data stays in the browser).
# Project Settings -> Data API / API Keys in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional: YouTube Data API v3 (real thumbnails + in-app playback) ---
# Without it, the app falls back to plain YouTube search links.
# Get one at console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials.
YOUTUBE_API_KEY=
